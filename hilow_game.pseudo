START hilow_game

    OUTPUT "Enter the lower bound"
    INPUT lower_bound
    
    OUTPUT "Enter upper bound"
    INPUT upper_bound
    
    WHILE lower_bound >= upper_bound
        OUTPUT "Invalid input, please try again"
        OUTPUT "Enter the lower bound"
        INPUT lower_bound
    
        OUTPUT "Enter upper bound"
        INPUT upper_bound        

    SET secret_number = RANDOM INTEGER BETWEEN lower_bound AND upper_bound

    OUTPUT "Guess a number between", lower_bound, "and", upper_bound
    INPUT num_guess
    
    WHILE num_guess < lower_bound OR num_guess > upper_bound
        OUTPUT "Invalid entry, please try again"
        OUTPUT "Guess a number between", lower_bound, "and", upper_bound
        INPUT num_guess
       
    WHILE secret_number < num_guess OR secret_number > num_guess
        IF num_guess > secret_number
            OUTPUT "Nope, too high"
            OUTPUT "Guess another number"
            INPUT num_guess
            
            WHILE num_guess < lower_bound OR num_guess > upper_bound
                OUTPUT "Invalid entry, please try again"
                OUTPUT "Guess a number between", lower_bound, "and", upper_bound
                INPUT num_guess
        ELSE 
            OUTPUT "Nope, too low"
            OUTPUT "Guess another number"
            INPUT num_guess
            WHILE num_guess < lower_bound OR num_guess > upper_bound
                OUTPUT "Invalid entry, please try again"
                OUTPUT "Guess a number between", lower_bound, "and", upper_bound
                INPUT num_guess     

    OUTPUT "You got it!"
    OUTPUT "Play again?"
    INPUT answer
    WHILE LOWERCASE(answer) == "yes"
        OUTPUT "Enter the lower bound"
        INPUT lower_bound
    
        OUTPUT "Enter upper bound"
        INPUT upper_bound
    
        WHILE lower_bound >= upper_bound
            OUTPUT "Invalid input, please try again"
            OUTPUT "Enter the lower bound"
            INPUT lower_bound
    
            OUTPUT "Enter upper bound"
            INPUT upper_bound        

        SET secret_number = RANDOM INTEGER BETWEEN lower_bound AND upper_bound

        OUTPUT "Guess a number between", lower_bound, "and", upper_bound
        INPUT num_guess
    
        WHILE num_guess < lower_bound OR num_guess > upper_bound
            OUTPUT "Invalid entry, please try again"
            OUTPUT "Guess a number between", lower_bound, "and", upper_bound
            INPUT num_guess
       
        WHILE secret_number < num_guess OR secret_number > num_guess
            IF num_guess > secret_number
                OUTPUT "Nope, too high"
                OUTPUT "Guess another number"
                INPUT num_guess
            
                WHILE num_guess < lower_bound OR num_guess > upper_bound
                    OUTPUT "Invalid entry, please try again"
                    OUTPUT "Guess a number between", lower_bound, "and", upper_bound
                    INPUT num_guess
            ELSE 
                OUTPUT "Nope, too low"
                OUTPUT "Guess another number"
                INPUT num_guess
                WHILE num_guess < lower_bound OR num_guess > upper_bound
                    OUTPUT "Invalid entry, please try again"
                    OUTPUT "Guess a number between", lower_bound, "and", upper_bound
                    INPUT num_guess     

        OUTPUT "You got it!"
        OUTPUT "Play again?"
        INPUT answer
    OUTPUT "Goodbye!"

END hilow_game
